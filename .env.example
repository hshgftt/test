# 数据库地址配置（三选一，优先级从高到低）
# 复制本文件为 .env 后按需修改即可

# ── 方式1（推荐本地开发）：SQLite 文件 ─────────────────────
# 相对路径（相对项目根目录）或绝对路径都支持
SQLITE_PATH=./dev.db

# ── 方式2：SQLite 开关，默认落在 ./vehicle_test.db ──────────
# USE_SQLITE=1

# ── 方式3（生产）：完整 SQLAlchemy URL ──────────────────────
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/vehicle_test
#
# 注意：SQLITE_PATH / USE_SQLITE 优先级高于 DATABASE_URL。
#       想用 PostgreSQL 就把方式1、2 注释掉。

# ── 服务启动参数（python -m app.main 时使用）────────────────
# HOST=127.0.0.1
# PORT=8000
# RELOAD=1
