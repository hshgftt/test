# ═══════════════════════════════════════════════════════════════════
# 车辆试验数据平台 —— 不提交清单
#
# 原则：代码和配置模板入库，数据 / 依赖 / 构建产物 / 密钥一律不入库。
# 注意：已经 tracked 的文件不会因为写进这里就自动失效，需要
#       git rm -r --cached <路径>  把它们从索引里摘掉（磁盘文件不动）。
# ═══════════════════════════════════════════════════════════════════

# ── 数据库：本地数据，动辄几个 GB ──────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
dev.db
vehicle_test.db

# ── 环境变量 / 密钥（.env.example 是模板，必须保留）──────────────
.env
.env.*
!.env.example

# ── 业务数据目录：导入用的原始数据，体积大且属于业务资产 ────────────
/data/
/uploads/
.uploads/

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/

# 测试 / 类型检查 / 覆盖率缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ── Node / 前端 ───────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/node_modules/
dist/
.vite/
*.tsbuildinfo

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# e2e 截图产物
frontend/e2e-shots/

# ── 编辑器 / 操作系统 ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── 临时文件 ──────────────────────────────────────────────────────
tmp_*.db
*.tmp
*.bak

# ── AI 工具工作区（会话记忆等，属个人本地状态）─────────────────────
